import "./style.css";
import config from "#config";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { LiveView } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { Show, TicketType, posterUrl, typesFor, sales } from "#app/shared/services/shows";
import { money, day, when, time } from "#app/shared/format";
import { Button } from "@elements/ui/button";
import { Card, CardHeader, CardTitle } from "@elements/ui/card";
import { Table, TableHead, TableCell } from "@elements/ui/table";
import { Progress } from "@elements/ui/progress";

export interface PastShow {
  id: string;
  title: string;
  startsAt: Date;
  sold: number;
  capacity: number;
  checkedIn: number;
  revenue: number;
}

<html lang="en" class="page-admin" (shows: Show[], types: LiveView<TicketType>, past: PastShow[])>
  <head>
    <title>Admin · {config.venue.name}</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout section="admin" width="is-wide">
      <div class="page-shell is-wide stack is-xl">
        <div class="admin-head row">
          <div class="stack is-xs">
            <p class="eyebrow">Admin</p>
            <h1>Sales</h1>
          </div>
          <div class="cluster">
            <Button href="/admin/shows/new" variant="primary">New show</Button>
          </div>
        </div>

        <div class="stats">
          <div class="stat">
            <p class="stat-label">Upcoming tickets sold</p>
            <p class="stat-value">{sales([...types]).sold.toLocaleString("en-US")}</p>
            <p class="stat-sub">of {sales([...types]).capacity.toLocaleString("en-US")} across {shows.length} shows</p>
          </div>
          <div class="stat">
            <p class="stat-label">Upcoming revenue</p>
            <p class="stat-value">{money(sales([...types]).revenue)}</p>
            <p class="stat-sub">at face value</p>
          </div>
          <div e:if={shows.length > 0} class="stat">
            <p class="stat-label">{when(shows[0].startsAt)}: {shows[0].title}</p>
            <p class="stat-value">{sales(typesFor(types, shows[0].id)).checkedIn} in</p>
            <p class="stat-sub">of {sales(typesFor(types, shows[0].id)).sold} sold · doors {time(shows[0].doorsAt)}</p>
          </div>
        </div>

        <Card>
          <CardHeader>
            <CardTitle level={2}>Upcoming shows</CardTitle>
          </CardHeader>
          <Table label="Upcoming shows">
            <table>
              <thead>
                <tr>
                  <TableHead>Show</TableHead>
                  <TableHead>Date</TableHead>
                  <TableHead align="end">Sold</TableHead>
                  <TableHead></TableHead>
                  <TableHead align="end">Revenue</TableHead>
                  <TableHead align="end">Checked in</TableHead>
                </tr>
              </thead>
              <tbody>
                <tr e:for={show of shows}>
                  <TableCell class="show-cell">
                    <a href={`/admin/shows/${show.id}`} class="row">
                      <img class="thumb" src={posterUrl(show)} alt="" width="40" height="60">
                      <span>{show.title}</span>
                    </a>
                  </TableCell>
                  <TableCell>{when(show.startsAt)}</TableCell>
                  <TableCell align="end">{sales(typesFor(types, show.id)).sold} / {sales(typesFor(types, show.id)).capacity}</TableCell>
                  <TableCell>
                    <Progress class="sold-meter"
                              size="sm"
                              value={sales(typesFor(types, show.id)).sold}
                              max={sales(typesFor(types, show.id)).capacity}
                              attrs={{ "aria-label": `${show.title} sold` }} />
                  </TableCell>
                  <TableCell align="end">{money(sales(typesFor(types, show.id)).revenue)}</TableCell>
                  <TableCell align="end">{sales(typesFor(types, show.id)).checkedIn}</TableCell>
                </tr>
              </tbody>
            </table>
          </Table>
        </Card>

        <Card e:if={past.length > 0}>
          <CardHeader>
            <CardTitle level={2}>Past shows</CardTitle>
          </CardHeader>
          <Table label="Past shows">
            <table>
              <thead>
                <tr>
                  <TableHead>Show</TableHead>
                  <TableHead>Date</TableHead>
                  <TableHead align="end">Sold</TableHead>
                  <TableHead align="end">Revenue</TableHead>
                  <TableHead align="end">Attended</TableHead>
                </tr>
              </thead>
              <tbody>
                <tr e:for={p of past}>
                  <TableCell><a href={`/admin/shows/${p.id}`}>{p.title}</a></TableCell>
                  <TableCell>{day(p.startsAt)}</TableCell>
                  <TableCell align="end">{p.sold} / {p.capacity}</TableCell>
                  <TableCell align="end">{money(p.revenue)}</TableCell>
                  <TableCell align="end">{p.checkedIn}</TableCell>
                </tr>
              </tbody>
            </table>
          </Table>
        </Card>
      </div>
    </Layout>
  </body>
</html>
