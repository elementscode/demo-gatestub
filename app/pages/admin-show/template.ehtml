import "./style.css";
import config from "#config";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { LiveView, ValidationError } from "@elements/app";
import type { FieldErrors } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { Show, TicketType, posterUrl, remaining, sales } from "#app/shared/services/shows";
import { money, longDay, day, time } from "#app/shared/format";
import { RecentOrder, TypeForm, addTicketType, setQuantity } from "./services";
import { Button } from "@elements/ui/button";
import { Alert, AlertDescription } from "@elements/ui/alert";
import { Card, CardHeader, CardTitle, CardContent } from "@elements/ui/card";
import { Table, TableHead, TableCell } from "@elements/ui/table";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { NumberInput } from "@elements/ui/number-input";
import { Empty } from "@elements/ui/empty";

interface AddForm extends TypeForm {
  errors: FieldErrors<TypeForm>;
}

function emptyAdd(): AddForm {
  return { name: "", price: "", quantity: "", errors: {} };
}

function onAddType(showId: string, form: AddForm) {
  form.errors = {};

  try {
    addTicketType(showId, { name: form.name, price: form.price, quantity: form.quantity });
    form.name = "";
    form.price = "";
    form.quantity = "";
  } catch (err: any) {
    form.errors = err instanceof ValidationError && err.errors ? err.errors : { name: [err.message] };
  }
}

function onQuantity(t: TicketType, status: { error: string }) {
  status.error = "";

  try {
    setQuantity(t.id, t.quantity);
  } catch (err: any) {
    status.error = err.message;
  }
}

function pct(n: number, of: number): string {
  return `${of === 0 ? 0 : Math.round((n / of) * 100)}%`;
}

<html lang="en" class="page-admin-show" (
  show: Show,
  types: LiveView<TicketType>,
  orders: RecentOrder[],
  created: boolean,
  private add: AddForm = emptyAdd(),
  private status: { error: string } = { error: "" },
)>
  <head>
    <title>{show.title} · Admin · {config.venue.name}</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout section="admin" width="is-wide">
      <div class="page-shell is-wide stack is-xl">
        <a href="/admin">← All shows</a>

        <div class="admin-head row">
          <div class="show-summary row">
            <img src={posterUrl(show)} alt={`${show.title} poster`} width="96" height="144">
            <div class="stack is-xs">
              <p class="eyebrow">{longDay(show.startsAt)}</p>
              <h1>{show.title}</h1>
              <p>{show.support}</p>
              <p>Doors {time(show.doorsAt)} · Show {time(show.startsAt)}</p>
            </div>
          </div>
          <div class="cluster">
            <Button href={`/shows/${show.id}`} variant="ghost">Public page</Button>
            <Button href={`/door/${show.id}`} variant="primary">Open door</Button>
          </div>
        </div>

        <Alert e:if={created} variant="success" role="status">
          <AlertDescription>Show created and on sale at <a href={`/shows/${show.id}`}>its public page</a>.</AlertDescription>
        </Alert>

        <div class="stats">
          <div class="stat">
            <p class="stat-label">Sold</p>
            <p class="stat-value">{sales([...types]).sold}</p>
            <p class="stat-sub">of {sales([...types]).capacity} · {pct(sales([...types]).sold, sales([...types]).capacity)}</p>
          </div>
          <div class="stat">
            <p class="stat-label">Revenue</p>
            <p class="stat-value">{money(sales([...types]).revenue)}</p>
            <p class="stat-sub">at face value</p>
          </div>
          <div class="stat">
            <p class="stat-label">Checked in</p>
            <p class="stat-value">{sales([...types]).checkedIn}</p>
            <p class="stat-sub">of {sales([...types]).sold} sold · {pct(sales([...types]).checkedIn, sales([...types]).sold)}</p>
          </div>
        </div>

        <Card>
          <CardHeader>
            <CardTitle level={2}>Ticket types</CardTitle>
          </CardHeader>
          <Table label="Ticket types">
            <table>
              <thead>
                <tr>
                  <TableHead>Type</TableHead>
                  <TableHead align="end">Price</TableHead>
                  <TableHead align="end">For sale</TableHead>
                  <TableHead align="end">Sold</TableHead>
                  <TableHead align="end">Left</TableHead>
                  <TableHead align="end">Checked in</TableHead>
                  <TableHead align="end">Revenue</TableHead>
                </tr>
              </thead>
              <tbody>
                <tr e:for={t of types.sort((a, b) => a.position - b.position)}>
                  <TableCell>{t.name}</TableCell>
                  <TableCell align="end">{money(t.priceCents)}</TableCell>
                  <TableCell align="end">
                    <NumberInput value={t.quantity}
                                 class="quantity-input"
                                 size="sm"
                                 buttons="none"
                                 min={t.sold}
                                 attrs={{ "aria-label": `${t.name} quantity` }}
                                 onValueCommit={() => onQuantity(t, status)} />
                  </TableCell>
                  <TableCell align="end">{t.sold}</TableCell>
                  <TableCell align="end">{remaining(t)}</TableCell>
                  <TableCell align="end">{t.checkedIn}</TableCell>
                  <TableCell align="end">{money(t.sold * t.priceCents)}</TableCell>
                </tr>
              </tbody>
            </table>
          </Table>
          <CardContent class="stack">
            <Alert e:if={status.error} variant="danger" description={status.error} />

            <form class="add-type" onsubmit={() => onAddType(show.id, add)}>
              <Field label="New ticket type" error={add.errors.name?.[0] ?? ""} reserveError={false}>
                <Input value={add.name} placeholder="VIP, Early bird…" attrs={{ id: "type-name" }} />
              </Field>
              <Field label="Price ($)" error={add.errors.price?.[0] ?? ""} reserveError={false}>
                <Input value={add.price} placeholder="25" attrs={{ id: "type-price", inputmode: "decimal" }} />
              </Field>
              <Field label="Quantity" error={add.errors.quantity?.[0] ?? ""} reserveError={false}>
                <Input value={add.quantity} placeholder="50" attrs={{ id: "type-qty", inputmode: "numeric" }} />
              </Field>
              <Button type="submit">Add</Button>
            </form>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle level={2}>Recent orders</CardTitle>
          </CardHeader>
          <Table e:if={orders.length > 0} label="Recent orders">
            <table>
              <thead>
                <tr>
                  <TableHead>Buyer</TableHead>
                  <TableHead>Email</TableHead>
                  <TableHead align="end">Tickets</TableHead>
                  <TableHead align="end">Paid</TableHead>
                  <TableHead align="end">When</TableHead>
                </tr>
              </thead>
              <tbody>
                <tr e:for={o of orders}>
                  <TableCell><a href={`/orders/${o.token}`}>{o.name}</a></TableCell>
                  <TableCell>{o.email}</TableCell>
                  <TableCell align="end">{o.tickets}</TableCell>
                  <TableCell align="end">{money(o.amountTotal)}</TableCell>
                  <TableCell align="end">{day(o.createdAt)} {time(o.createdAt)}</TableCell>
                </tr>
              </tbody>
            </table>
          </Table>
          <Empty e:else description="No orders yet." />
        </Card>
      </div>
    </Layout>
  </body>
</html>
