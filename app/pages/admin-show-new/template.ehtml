import "./style.css";
import config from "#config";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { File, redirect, ValidationError } from "@elements/app";
import type { FieldErrors } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { ShowForm, createShow } from "./services";
import type { TypeForm } from "#app/pages/admin-show/services";
import { Button } from "@elements/ui/button";
import { Icon } from "@elements/ui/icon";
import { Alert } from "@elements/ui/alert";
import { Card, CardHeader, CardTitle, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { Textarea } from "@elements/ui/textarea";
import { DatePicker } from "@elements/ui/date-picker";
import { TimePicker } from "@elements/ui/time-picker";

interface NewShow {
  form: ShowForm;
  errors: FieldErrors<ShowForm>;
  message: string;
  busy: boolean;
}

let rows = 0;

function blank(): NewShow {
  return {
    form: {
      title: "",
      support: "",
      description: "",
      date: "",
      doors: "19:00",
      starts: "20:00",
      poster: null,
      types: [
        { id: "row-ga", name: "General admission", price: "20", quantity: "220" },
        { id: "row-balcony", name: "Balcony", price: "30", quantity: "60" },
      ],
    },
    errors: {},
    message: "",
    busy: false,
  };
}

function onAddRow(state: NewShow) {
  state.form.types.push({ id: `row-${++rows}`, name: "", price: "", quantity: "" });
}

function onRemoveRow(state: NewShow, row: TypeForm) {
  state.form.types = state.form.types.filter((t) => t.id !== row.id);
}

function onSubmit(state: NewShow) {
  state.errors = {};
  state.message = "";
  state.busy = true;

  try {
    let id = createShow(state.form);
    redirect(`/admin/shows/${id}?created=1`);
  } catch (err: any) {
    state.busy = false;

    if (err instanceof ValidationError && err.errors) {
      state.errors = err.errors;
    } else {
      state.message = err.message;
    }
  }
}

function previewUrl(poster: File | null): string {
  if (!poster || !poster.data || typeof URL === "undefined") {
    return "";
  }

  return URL.createObjectURL(new Blob([poster.data as BlobPart], { type: poster.contentType }));
}

<html lang="en" class="page-admin-show-new" (private state: NewShow = blank())>
  <head>
    <title>New show · Admin · {config.venue.name}</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout section="admin">
      <div class="page-shell is-form new-show stack is-lg">
        <a href="/admin">← All shows</a>
        <h1>New show</h1>

        <form class="stack is-lg" onsubmit={() => onSubmit(state)}>
          <Card>
            <CardContent class="stack">
              <Field label="Headliner" error={state.errors.title?.[0] ?? ""}>
                <Input value={state.form.title} placeholder="Mercury Fuzz Choir" attrs={{ id: "title" }} />
              </Field>

              <Field label="Support">
                <Input value={state.form.support} placeholder="with Lowercase Saints" attrs={{ id: "support" }} />
              </Field>

              <Field label="Description">
                <Textarea value={state.form.description} placeholder="One or two lines for the show page." attrs={{ id: "description" }} />
              </Field>

              <div class="when-row">
                <Field label="Date" invalid={!!state.errors.date} reserveError={false}>
                  <DatePicker value={state.form.date} block invalid={!!state.errors.date} placeholder="Pick a date" attrs={{ id: "date" }} />
                </Field>
                <Field label="Doors" invalid={!!state.errors.doors} reserveError={false}>
                  <TimePicker value={state.form.doors} block invalid={!!state.errors.doors} attrs={{ id: "doors" }} />
                </Field>
                <Field label="Show" invalid={!!state.errors.starts} reserveError={false}>
                  <TimePicker value={state.form.starts} block invalid={!!state.errors.starts} attrs={{ id: "starts" }} />
                </Field>
              </div>
              <p e:if={state.errors.date || state.errors.doors || state.errors.starts} class="error">
                {(state.errors.date ?? state.errors.doors ?? state.errors.starts)?.[0]}
              </p>
              <p class="hint">Times are {config.venue.name} local time ({config.venue.timezone}).</p>
            </CardContent>
          </Card>

          <Card>
            <CardHeader>
              <CardTitle level={2}>Poster</CardTitle>
            </CardHeader>
            <CardContent class="row is-start gap-4">
              <img e:if={state.form.poster} class="poster-preview" src={previewUrl(state.form.poster)} alt="Poster preview" width="128" height="192">
              <div class="field">
                <input type="file" accept="image/png,image/jpeg,image/webp,image/gif" value={state.form.poster} aria-label="Poster image">
                <p class="hint">Portrait, 2:3 works best. PNG, JPEG, WebP or GIF under 4 MB.</p>
                <p e:if={state.errors.poster} class="error">{state.errors.poster?.[0]}</p>
              </div>
            </CardContent>
          </Card>

          <Card>
            <CardHeader>
              <CardTitle level={2}>Ticket types</CardTitle>
            </CardHeader>
            <CardContent class="stack">
              <div class="type-row type-labels">
                <span>Name</span>
                <span>Price ($)</span>
                <span>Quantity</span>
                <span></span>
              </div>
              <div e:for={t of state.form.types} class="type-row">
                <Input value={t.name} placeholder="General admission" attrs={{ "aria-label": "Ticket type name" }} />
                <Input value={t.price} placeholder="20" attrs={{ "aria-label": "Price in dollars", inputmode: "decimal" }} />
                <Input value={t.quantity} placeholder="200" attrs={{ "aria-label": "Quantity", inputmode: "numeric" }} />
                <Button variant="ghost" size="sm" icon label="Remove ticket type" onclick={() => onRemoveRow(state, t)}><Icon name="x" /></Button>
              </div>
              <p e:if={state.errors.types} class="error">{state.errors.types?.[0]}</p>
              <div>
                <Button size="sm" onclick={() => onAddRow(state)}>Add ticket type</Button>
              </div>
            </CardContent>
          </Card>

          <Alert e:if={state.message} variant="danger" description={state.message} />

          <div class="cluster">
            <Button type="submit" variant="primary" size="lg" loading={state.busy}>Create show and put on sale</Button>
            <Button href="/admin" variant="ghost" size="lg">Cancel</Button>
          </div>
        </form>
      </div>
    </Layout>
  </body>
</html>
