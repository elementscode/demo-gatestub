import "./style.css";
import config from "#config";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { redirect } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { signin } from "#app/shared/services/auth";

interface SigninForm {
  email: string;
  password: string;
  error: string;
}

export const DEMO_LOGINS = [
  { role: "Admin", email: "admin@gatestub.test", password: "backstage" },
  { role: "Door", email: "door@gatestub.test", password: "frontdoor" },
];

function onSubmit(form: SigninForm, next: string) {
  try {
    let home = signin(form.email, form.password);
    form.error = "";
    redirect(next || home);
  } catch (err: any) {
    form.error = err.message;
  }
}

function onUse(form: SigninForm, next: string, email: string, password: string) {
  form.email = email;
  form.password = password;
  onSubmit(form, next);
}

<html lang="en" class="page-signin" (
  demo: boolean,
  next: string,
  private form: SigninForm = { email: "", password: "", error: "" },
)>
  <head>
    <title>Staff sign in · {config.venue.name}</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout>
      <div class="page-shell is-narrow signin stack is-lg">
        <form class="stack" onsubmit={() => onSubmit(form, next)}>
          <h1>Staff sign in</h1>
          <p class="hint">For {config.venue.name} admins and door staff. Buying tickets needs no account.</p>

          <p e:if={form.error} class="error" role="alert">{form.error}</p>

          <div class="field">
            <label for="email">Email</label>
            <input id="email"
                   name="email"
                   type="email"
                   value={form.email}
                   autocomplete="email"
                   autocapitalize="none"
                   spellcheck={false}
                   required>
          </div>

          <div class="field">
            <label for="password">Password</label>
            <input id="password"
                   name="password"
                   type="password"
                   value={form.password}
                   autocomplete="current-password"
                   required>
          </div>

          <button type="submit" class="is-primary is-block">Sign in</button>
        </form>

        <div e:if={demo} class="card demo-logins">
          <div class="card-head">
            <h2>Demo logins</h2>
          </div>
          <div class="card-body">
            <table>
              <tbody>
                <tr e:for={login of DEMO_LOGINS}>
                  <td>
                    <strong>{login.role}</strong><br>
                    <code>{login.email}</code><br>
                    <code>{login.password}</code>
                  </td>
                  <td class="text-right">
                    <button type="button" class="is-sm" onclick={() => onUse(form, next, login.email, login.password)}>Use</button>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </Layout>
  </body>
</html>
