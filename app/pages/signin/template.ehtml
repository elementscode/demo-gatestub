import "./style.css";
import config from "#config";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { redirect } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { signin } from "#app/shared/services/auth";
import { Button } from "@elements/ui/button";
import { Alert } from "@elements/ui/alert";
import { Card, CardHeader, CardTitle, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { Table, TableCell } from "@elements/ui/table";

interface SigninForm {
  email: string;
  password: string;
  error: string;
}

export const DEMO_LOGINS = [
  { role: "Admin", email: "admin@gatestub.test", password: "backstage" },
  { role: "Door", email: "door@gatestub.test", password: "frontdoor" },
];

function onSubmit(form: SigninForm, next: string) {
  try {
    let home = signin(form.email, form.password);
    form.error = "";
    redirect(next || home);
  } catch (err: any) {
    form.error = err.message;
  }
}

function onUse(form: SigninForm, next: string, email: string, password: string) {
  form.email = email;
  form.password = password;
  onSubmit(form, next);
}

<html lang="en" class="page-signin" (
  demo: boolean,
  next: string,
  private form: SigninForm = { email: "", password: "", error: "" },
)>
  <head>
    <title>Staff sign in · {config.venue.name}</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout>
      <div class="page-shell is-narrow signin stack is-lg">
        <form class="stack" onsubmit={() => onSubmit(form, next)}>
          <h1>Staff sign in</h1>
          <p class="hint">For {config.venue.name} admins and door staff. Buying tickets needs no account.</p>

          <Alert e:if={form.error} variant="danger" description={form.error} />

          <Field label="Email" name="email" required>
            <Input type="email"
                   value={form.email}
                   attrs={{ id: "email", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
          </Field>

          <Field label="Password" name="password" required>
            <Input type="password"
                   value={form.password}
                   attrs={{ id: "password", autocomplete: "current-password" }} />
          </Field>

          <Button type="submit" variant="primary" block>Sign in</Button>
        </form>

        <Card e:if={demo} class="demo-logins">
          <CardHeader>
            <CardTitle level={2}>Demo logins</CardTitle>
          </CardHeader>
          <CardContent>
            <Table>
              <table>
                <tbody>
                  <tr e:for={login of DEMO_LOGINS}>
                    <TableCell>
                      <strong>{login.role}</strong><br>
                      <code>{login.email}</code><br>
                      <code>{login.password}</code>
                    </TableCell>
                    <TableCell align="end">
                      <Button size="sm" onclick={() => onUse(form, next, login.email, login.password)}>Use</Button>
                    </TableCell>
                  </tr>
                </tbody>
              </table>
            </Table>
          </CardContent>
        </Card>
      </div>
    </Layout>
  </body>
</html>
